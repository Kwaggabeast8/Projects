# Copy to .env, fill in what you use, then:  set -a; source .env; set +a
ANTHROPIC_API_KEY=

# Smart home (Home Assistant -> Profile -> Long-lived access tokens)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Email (Gmail: enable 2FA and create an App Password)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com

# Google Calendar (OAuth "Desktop app" client JSON from Google Cloud Console)
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
