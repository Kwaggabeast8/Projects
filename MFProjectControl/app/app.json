{
  "expo": {
    "name": "MF Project Control",
    "slug": "mf-project-control",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "za.co.mfbuilding.projectcontrol", "infoPlist": { "NSAllowsArbitraryLoads": false } },
    "android": {
      "package": "za.co.mfbuilding.projectcontrol",
      "adaptiveIcon": { "backgroundColor": "#12263F", "foregroundImage": "./assets/android-icon-foreground.png", "backgroundImage": "./assets/android-icon-background.png", "monochromeImage": "./assets/android-icon-monochrome.png" }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro", "output": "single", "name": "MF Project Control", "shortName": "MF Control", "themeColor": "#12263F" },
    "plugins": [
      ["expo-image-picker", { "photosPermission": "MF Project Control needs access to your photos to attach site photos.", "cameraPermission": "MF Project Control needs the camera to take site photos." }]
    ]
  }
}
