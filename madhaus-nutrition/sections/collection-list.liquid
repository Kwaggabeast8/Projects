<section class="section">
  <div class="container">
    <div class="section__head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile" href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 700 | image_tag: loading: 'lazy' }}{%- endif -%}
          <span class="tile__label">{{ block.settings.label | default: c.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by goal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP BY GOAL" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (overrides collection name)", "default": "BUILD MUSCLE" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by goal",
      "blocks": [
        { "type": "tile", "settings": { "label": "BUILD MUSCLE" } },
        { "type": "tile", "settings": { "label": "ENERGY & FOCUS" } },
        { "type": "tile", "settings": { "label": "RECOVERY" } },
        { "type": "tile", "settings": { "label": "STACKS & BUNDLES" } }
      ]
    }
  ]
}
{% endschema %}
