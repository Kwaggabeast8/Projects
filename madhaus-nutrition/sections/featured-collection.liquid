<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">View all &rarr;</a>
      {%- endif -%}
    </div>
    <div class="grid">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card"><div class="card__media"><div class="card__placeholder">MADHAUS</div></div>
          <div class="card__body"><h3 class="card__title">Your product</h3><div class="price"><span class="price__current">$0.00</span></div></div></article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "BEST SELLERS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
