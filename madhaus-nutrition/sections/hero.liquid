<section class="hero" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: class: 'hero__bg', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x', preload: 'metadata' }}
  {%- elsif section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__bg', loading: 'eager', widths: '800, 1200, 1600, 2000', sizes: '100vw' }}
  {%- else -%}
    <div class="hero__glow" aria-hidden="true"></div>
  {%- endif -%}
  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video (optional)", "info": "Short looping MP4, under 15 seconds. Used instead of the image if set." },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Dark overlay", "default": 60 },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "NEW DROP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FUEL THE MADNESS" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clean, high-performance nutrition for people who train hard." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Best sellers" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
