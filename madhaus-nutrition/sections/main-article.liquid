<article class="section">
  <div class="container container--narrow">
    <p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>
    <h1 class="page-title">{{ article.title }}</h1>
    {%- if article.image -%}{{ article.image | image_url: width: 1200 | image_tag: loading: 'eager' }}{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a class="link-arrow" href="{{ blog.url }}">&larr; Back to {{ blog.title }}</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
