<section class="section">
  <div class="container contact">
    <div class="contact__info">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="page-title">{{ section.settings.heading }}</h1>
      <p class="muted">{{ section.settings.text }}</p>
      <ul class="contact__details">
        {%- if section.settings.email != blank -%}<li><strong>Email</strong><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>{%- endif -%}
        {%- if section.settings.hours != blank -%}<li><strong>Hours</strong><span>{{ section.settings.hours }}</span></li>{%- endif -%}
        {%- if section.settings.reply != blank -%}<li><strong>Response time</strong><span>{{ section.settings.reply }}</span></li>{%- endif -%}
      </ul>
    </div>

    <div class="contact__form">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="alert alert--ok" role="status">Thanks! We got your message and will get back to you shortly.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="alert alert--err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field-row">
          <div class="field">
            <label for="ContactForm-name">Name</label>
            <input id="ContactForm-name" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="ContactForm-email">Email</label>
            <input id="ContactForm-email" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
          </div>
        </div>
        <div class="field">
          <label for="ContactForm-phone">Phone (optional)</label>
          <input id="ContactForm-phone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>
        <div class="field">
          <label for="ContactForm-topic">Topic</label>
          <select id="ContactForm-topic" name="contact[topic]">
            <option>Order question</option>
            <option>Product advice</option>
            <option>Shipping &amp; returns</option>
            <option>Wholesale / sponsorship</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="ContactForm-body">Message</label>
          <textarea id="ContactForm-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>
        <button class="btn btn--block" type="submit">Send message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "GET IN TOUCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTACT US" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a product, an order or what to stack? Send us a message." },
    { "type": "text", "id": "email", "label": "Support email", "default": "support@madhausnutrition.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon-Fri, 9am-5pm" },
    { "type": "text", "id": "reply", "label": "Response time", "default": "Within 24 hours" }
  ]
}
{% endschema %}
