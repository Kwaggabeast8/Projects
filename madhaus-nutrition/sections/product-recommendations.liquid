<section class="section product-recs" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section__head"><h2>{{ section.settings.heading }}</h2></div>
      <div class="grid">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var el = document.querySelector('.product-recs[data-url]');
    if (!el || el.querySelector('.grid')) return;
    fetch(el.dataset.url).then(function (r) { return r.text(); }).then(function (html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.querySelector('.product-recs');
      if (fresh && fresh.innerHTML.trim()) el.innerHTML = fresh.innerHTML;
    }).catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "Recommended products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "STACK IT WITH" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
