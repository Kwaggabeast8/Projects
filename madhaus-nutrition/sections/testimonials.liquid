<section class="section section--surface">
  <div class="container">
    <h2 class="center">{{ section.settings.heading }}</h2>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <figure class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}<span{% if i > block.settings.rating %} class="off"{% endif %}>&#9733;</span>{%- endfor -%}
          </div>
          <blockquote>"{{ block.settings.quote }}"</blockquote>
          <figcaption>{{ block.settings.name }}{% if block.settings.verified %} <small>&#10003; Verified buyer</small>{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "REAL RESULTS. REAL PEOPLE." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Best pre-workout I've tried. Clean energy, no crash." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "Best pre-workout I've tried. Clean energy, no crash.", "name": "Customer name" } },
        { "type": "review", "settings": { "quote": "Mixes perfectly and tastes insane. Reordered twice already.", "name": "Customer name" } },
        { "type": "review", "settings": { "quote": "Finally a brand with honest labels. Full doses, no gimmicks.", "name": "Customer name" } }
      ]
    }
  ]
}
{% endschema %}
