<div class="trust">
  <div class="container trust__inner">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "FREE SHIPPING" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $75" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "title": "FREE SHIPPING", "text": "On orders over $75" } },
        { "type": "item", "settings": { "title": "LAB TESTED", "text": "Every batch" } },
        { "type": "item", "settings": { "title": "30-DAY GUARANTEE", "text": "Love it or we fix it" } },
        { "type": "item", "settings": { "title": "SECURE CHECKOUT", "text": "Shop Pay, Apple Pay, cards" } }
      ]
    }
  ]
}
{% endschema %}
